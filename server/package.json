{
  "name": "card-flip-game-server",
  "version": "1.0.0",
  "description": "大喜利カードゲーム API",
  "main": "dist/lambda.js",
  "scripts": {
    "dev": "ts-node src/local.ts",
    "build": "tsc",
    "start": "node dist/local.js",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\" \"db/**/*.ts\"",
    "db:migrate": "ts-node db/cli.ts migrate",
    "db:seed": "ts-node db/cli.ts seed",
    "db:reset": "ts-node db/cli.ts reset",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "party-game",
    "oogiri",
    "serverless"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.490.0",
    "@aws-sdk/lib-dynamodb": "^3.490.0",
    "@codegenie/serverless-express": "^4.17.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
